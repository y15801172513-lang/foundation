{
  "name": "ai-product-foundation-kit",
  "version": "0.2.7",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/unit/*.test.mjs tests/integration/*.test.mjs tests/contracts/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "build": "node apps/management-center/build.mjs && npm run build --prefix examples/foundation-events",
    "audit:deps": "node scripts/dependency-declaration-audit.mjs",
    "audit:ui": "node scripts/ui-governance-audit.mjs",
    "candidate": "node scripts/build-candidate.mjs",
    "preview": "node scripts/preview.mjs start",
    "preview:status": "node scripts/preview.mjs status",
    "preview:stop": "node scripts/preview.mjs stop"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "jsdom": "29.1.1"
  }
}
