{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundation.local/schemas/local-manager-confirmation-v1.json",
  "title": "Foundation Local Manager Confirmation Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "operationId", "operation", "planHash", "effectHash", "targetRoots", "creates", "replacements", "deletes", "preserves", "fileCount", "byteCount", "protectedDataHashes", "expectedBeforeState", "createdAt", "expiresAt", "state", "singleUse"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "sessionId": {"type": "string", "pattern": "^manager-session-[0-9a-f-]+$"},
    "operationId": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "planHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effectHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effect": {"type": "object"},
    "subEffects": {"type": "array", "items": {"type": "object"}},
    "targetRoots": {"type": "array", "items": {"type": "string"}},
    "creates": {"type": "array", "items": {"type": "string"}},
    "replacements": {"type": "array", "items": {"type": "string"}},
    "deletes": {"type": "array", "items": {"type": "string"}},
    "preserves": {"type": "array", "items": {"type": "string"}},
    "fileCount": {"type": "integer", "minimum": 0},
    "byteCount": {"type": "integer", "minimum": 0},
    "protectedDataHashes": {"type": "object"},
    "residuals": {"type": "array", "items": {"type": "object"}},
    "expectedBeforeState": {},
    "currentVersion": {"type": ["string", "null"]},
    "targetVersion": {"type": ["string", "null"]},
    "sourceIdentity": {"type": ["string", "null"]},
    "createdAt": {"type": "integer"},
    "expiresAt": {"type": "integer"},
    "state": {"enum": ["pending", "executing", "consumed", "completed", "failed", "cancelled"]},
    "singleUse": {"const": true},
    "confirmationAction": {"type": "string"},
    "threatLimitation": {"type": "string"},
    "confirmedAt": {"type": "integer"},
    "completedAt": {"type": "integer"},
    "cancelledAt": {"type": "integer"},
    "failedAt": {"type": "integer"},
    "consumption": {"type": "object"},
    "consumptions": {"type": "array", "items": {"type": "object"}},
    "failure": {"type": "object"},
    "result": {}
  }
}
