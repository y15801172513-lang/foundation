{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "foundation:semantic-review-1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "planDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "codex",
            "reviewer"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "label",
        "source"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "judgment": {
            "enum": [
              "passed",
              "failed",
              "pending"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "coveredFactIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceRefIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "expected",
          "observation",
          "judgment",
          "rationale",
          "coveredFactIds",
          "evidenceIds",
          "sourceRefIds",
          "limitations"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "planDigest",
    "reviewer",
    "checks"
  ]
}
